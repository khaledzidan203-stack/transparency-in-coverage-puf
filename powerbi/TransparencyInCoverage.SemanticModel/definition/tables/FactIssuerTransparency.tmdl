	partition FactIssuerTransparency = m
		mode: import
		source =
				let
				    Source =
				        fxLoadCanonicalCsv(
				            "fact_issuer_transparency.csv",
				            {
				                {"ReportingPeriodKey", Int64.Type},
				                {"StateKey", Int64.Type},
				                {"IssuerKey", Int64.Type},
				
				                {"ClaimsReceivedOutOfNetwork", Int64.Type},
				                {"ClaimsReceivedInNetwork", Int64.Type},
				                {"ClaimsDeniedOutOfNetwork", Int64.Type},
				                {"ClaimsDeniedInNetwork", Int64.Type},
				                {"ClaimsResubmittedOutOfNetwork", Int64.Type},
				                {"ClaimsResubmittedInNetwork", Int64.Type},
				
				                {"InternalAppealsFiled", Int64.Type},
				                {"InternalAppealsOverturned", Int64.Type},
				                {"InternalAppealsOverturnPctPublished", type number},
				
				                {"ExternalAppealsFiled", Int64.Type},
				                {"ExternalAppealsOverturned", Int64.Type},
				                {"ExternalAppealsOverturnPctPublished", type number},
				
				                {"SourcePlanRowCount", Int64.Type},
				                {"SourceSheetCount", Int64.Type},
				                {"SourceSheets", type text},
				                {"SourceFileName", type text},
				                {"SourceFileSHA256", type text}
				            }
				        )
				in
