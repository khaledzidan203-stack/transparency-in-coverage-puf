/// Canonical data folder path
expression DataFolderPath = "D:\transparency-in-coverage-puf\data\canonical" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	lineageTag: ff4ba22b-39a9-440c-9d04-39551105205b

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Text

expression fxLoadCanonicalCsv =
		(FileName as text, TypeMap as list) as table =>
		let
		    Source =
		        Csv.Document(
		            File.Contents(DataFolderPath & "\" & FileName),
		            [
		                Delimiter = ",",
		                Encoding = 65001,
		                QuoteStyle = QuoteStyle.Csv
		            ]
		        ),
		
		    PromotedHeaders =
		        Table.PromoteHeaders(
		            Source,
		            [PromoteAllScalars = true]
		        ),
		
		    ChangedTypes =
		        Table.TransformColumnTypes(
		            PromotedHeaders,
		            TypeMap,
		            "en-US"
		        )
		in
		    ChangedTypes
	lineageTag: 61f75ea9-4ef0-4533-bea8-e8d0d2221ed2

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Function

